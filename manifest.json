{
  "manifest_version": 3,
  "name": "Like Ebook",
  "description": "Turns article pages into a focused Mercury-style reader view.",
  "version": "0.1.0",
  "action": {
    "default_title": "Toggle reader view"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+R",
        "mac": "Alt+R"
      },
      "description": "Toggle reader view"
    }
  }
}
